---
// Site header — single source of truth for every page.
//   tone="dark"  → sits on the midnight hero canvas (home, error pages)
//   tone="light" → nav-bar-light for reading / transactional pages
// The theme toggle is wired by src/scripts/personalize.ts.
interface Props {
	tone?: "dark" | "light";
}

const { tone = "light" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
	{ href: "/#faq", label: "FAQ" },
	{ href: "/about", label: "About" },
	{ href: "/contact", label: "Contact" },
];
---

<header
	class:list={[
		"w-full sticky top-0 z-50 border-b",
		tone === "dark" ? "band-dark border-[#362d59]" : "band-light border-[var(--color-hairline)]",
	]}
>
	<div class="max-w-[1152px] mx-auto w-full h-16 px-4 md:px-6 flex items-center justify-between gap-4">
		<a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="VideoCompressOnline home">
			<svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
				<rect x="2" y="2" width="28" height="28" rx="8" fill="var(--primary)" />
				<path d="M13 10.5v11l8.5-5.5L13 10.5z" fill="var(--on-primary)" />
				<path d="M6.5 9.5 9 12M6.5 22.5 9 20M25.5 9.5 23 12M25.5 22.5 23 20" stroke="var(--on-primary)" stroke-width="1.8" stroke-linecap="round" />
			</svg>
			<span class="text-[16px] font-semibold text-[var(--color-ink)]">
				VideoCompress<span class="text-[var(--color-mute)] font-medium">Online</span>
			</span>
		</a>

		<nav class="hidden md:flex items-center gap-1" aria-label="Primary">
			{links.map((l) => (
				<a
					href={l.href}
					class:list={[
						"px-3 py-2 rounded-md text-[15px] font-medium hover:bg-[var(--color-canvas-soft-2)]",
						path === l.href ? "text-[var(--color-ink)]" : "text-[var(--color-body)] hover:text-[var(--color-ink)]",
					]}
					aria-current={path === l.href ? "page" : undefined}
				>
					{l.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-2">
			<button
				id="theme-toggle"
				type="button"
				class="btn btn-ghost btn-sm !rounded-xl"
				aria-label="Switch theme"
				title="Switch theme"
			>
				<span id="theme-icon" class="inline-flex w-4 h-4 items-center justify-center" aria-hidden="true"></span>
				<span id="theme-label" class="hidden lg:inline">Dark</span>
			</button>
			<a href="/#compressor" class:list={["btn btn-primary btn-sm", tone === "dark" && "btn-glow"]}>
				Compress<span class="hidden sm:inline">&nbsp;video</span>
			</a>
		</div>
	</div>
</header>
