---
import Layout from '../layouts/Layout.astro';
import ErrorState from '../components/ErrorState.astro';
---

<Layout
	title={'403 – Forbidden | VideoCompressOnline'}
	description={"You don't have permission to access this page."}
>
	<ErrorState
		code="403"
		title={'Access forbidden'}
		message={"You don't have permission to access this page. If you believe this is a mistake, please contact our support team and we'll look into it."}
		primary={{ href: "/", label: "Go to homepage" }}
		secondary={{ href: "/contact", label: "Contact support" }}
	/>
</Layout>
