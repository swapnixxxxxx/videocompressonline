---
import Layout from '../layouts/Layout.astro';
import ErrorState from '../components/ErrorState.astro';
---

<Layout
	title={'500 – Server Error | VideoCompressOnline'}
	description={'Something went wrong on our end. Please try again shortly.'}
>
	<ErrorState
		code="500"
		title={'Internal server error'}
		message={'Something went wrong on our end. This is a temporary issue and our team has been notified. Since VideoCompressOnline processes everything locally in your browser, your videos are completely safe.'}
		primary={{ label: "Try again", reload: true }}
		secondary={{ href: "/", label: "Go to homepage" }}
		note={'<strong class="text-white font-semibold">Good to know:</strong> VideoCompressOnline uses WebAssembly to compress videos entirely within your browser. This error does not affect your local video files — they are stored only on your device and never uploaded to any server.'}
	/>
</Layout>
