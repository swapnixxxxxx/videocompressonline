---
import Layout from '../layouts/Layout.astro';
import ErrorState from '../components/ErrorState.astro';
---

<Layout
	title={'404 – Page Not Found | VideoCompressOnline'}
	description={"The page you're looking for doesn't exist. Head back to VideoCompressOnline to compress your videos for free."}
>
	<ErrorState
		code="404"
		title={'Page not found'}
		message={"The page you're looking for has been moved, deleted, or never existed. Don't worry, your videos are safe, and we can get you back on track."}
		primary={{ href: "/", label: "Go to homepage" }}
		secondary={{ href: "/#compressor", label: "Compress a video" }}
	/>
</Layout>
