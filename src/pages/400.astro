---
import Layout from '../layouts/Layout.astro';
import ErrorState from '../components/ErrorState.astro';
---

<Layout
	title={'400 – Bad Request | VideoCompressOnline'}
	description={'The request was invalid or malformed. Please go back and try again.'}
>
	<ErrorState
		code="400"
		title={'Bad request'}
		message={'The request you sent was invalid or malformed. This can happen due to a broken link, an expired session, or a typo in the URL. Try heading back to the homepage.'}
		primary={{ href: "/", label: "Go to homepage" }}
		secondary={{ href: "/contact", label: "Contact support" }}
	/>
</Layout>
