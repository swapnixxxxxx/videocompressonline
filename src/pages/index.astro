---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sticker from '../components/Sticker.astro';

const homepageSchemas = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": "VideoCompressOnline",
		"url": "https://www.videocompressonline.com/",
		"description": "Fast video compressor online to compress video files and reduce video size easily.",
	},
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		"name": "VideoCompressOnline",
		"url": "https://www.videocompressonline.com/",
		"description": "Free online video compressor to reduce video size and compress MP4, WebM, MKV, and MOV files up to 2 GB. Includes Discord (8MB) and email (25MB) presets.",
		"applicationCategory": "MultimediaApplication",
		"operatingSystem": "All",
		"offers": {
			"@type": "Offer",
			"price": "0",
			"priceCurrency": "USD",
		},
		"featureList": [
			"Compress MP4, WebM, MKV, and MOV videos online",
			"Reduce video file size up to 90%",
			"Discord-compatible 8MB and email 25MB presets",
			"Resilient chunked streaming for files up to 2 GB",
			"Preserve original framerate or strip audio tracks",
			"Zero watermarks and no account registration required",
		],
		"browserRequirements": "Requires a modern web browser",
		"softwareVersion": "2.0",
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"mainEntity": [
			{
				"@type": "Question",
				"name": "How do I compress a video online?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "To compress a video online, drag and drop your file into the uploader or select it from your device. Pick your preferred target size preset (such as 8 MB, 25 MB, 50 MB, or 100 MB), adjust audio or framerate settings if desired, and the compression engine will process your clip. Once completed, click Download Video to save your optimized MP4 file.",
				},
			},
			{
				"@type": "Question",
				"name": "How much can video size be reduced?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "Depending on the original video's resolution, framerate, and bitrate, file sizes can typically be reduced by 50% to 90%. For example, high-bitrate screen recordings or raw smartphone clips often shrink from 100 MB down to under 10 MB with minimal noticeable difference in visual quality.",
				},
			},
			{
				"@type": "Question",
				"name": "Which video formats are supported?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "VideoCompressOnline accepts all popular video formats including MP4, WebM, MKV, MOV, AVI, FLV, WMV, and 3GP. All compressed videos are delivered in the universally compatible MP4 (H.264 / AAC) format, ensuring they play seamlessly across all web browsers, desktop operating systems, and mobile devices.",
				},
			},
			{
				"@type": "Question",
				"name": "What is the maximum video file size I can compress?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "You can compress video files up to 2 GB. Our system uses chunked streaming technology that slices large files into smaller parts during transmission, preventing browser crashes and memory overloads even when processing massive clips.",
				},
			},
			{
				"@type": "Question",
				"name": "Does video compression reduce video quality?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "Video compression is lossy by nature, meaning some data is discarded to achieve smaller file sizes. However, VideoCompressOnline utilizes intelligent Constant Rate Factor (CRF) encoding and dynamic bitrate budgeting to remove data imperceptible to human eyes. Visual sharpness, motion fluidity, and audio clarity remain high.",
				},
			},
			{
				"@type": "Question",
				"name": "How long does the online compression process take?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "Compression speed depends primarily on your video's length, resolution, and internet connection. Most short clips (under 2 minutes) upload and compress within 10 to 30 seconds. Larger multi-hundred megabyte videos may take a couple of minutes to stream and encode.",
				},
			},
			{
				"@type": "Question",
				"name": "Are my uploaded videos kept private and secure?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "Yes. All transmissions are protected with end-to-end HTTPS/TLS encryption. Your video files are processed in automated isolated worker pipelines and are never watched, cataloged, or shared. Temporary upload chunks are deleted immediately after reassembly, and completed compressed videos are automatically purged from our servers within 24 hours.",
				},
			},
			{
				"@type": "Question",
				"name": "Can I compress videos specifically for Discord or email?",
				"acceptedAnswer": {
					"@type": "Answer",
					"text": "Yes. We provide pre-configured target size options specifically designed for platform limits. Select the 8 MB preset to share gameplay clips on standard Discord servers, or choose the 25 MB preset to comply with attachment ceilings on Gmail, Outlook, and Yahoo Mail.",
				},
			},
		],
	},
];
const faqs = (homepageSchemas[2] as { mainEntity: { name: string; acceptedAnswer: { text: string } }[] }).mainEntity;

const features = [
	{
		title: "Private & secure",
		body: "Encrypted transfer with automatic server cleanup. Your videos are processed securely and deleted right after download.",
		icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
	},
	{
		title: "Lightning-fast",
		body: "Chunked streaming uploads and native H.264 encoding keep compression quick, even for large files.",
		icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
	},
	{
		title: "No watermarks, no sign-up",
		body: "Compress files up to 2 GB with no account, no quantity limits, and no branding added to your video.",
		icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
	},
];

const steps = [
	{ title: "Select or drop your file", body: "Drag your video into the dropzone above or click to browse. Resilient chunked streaming handles files up to 2&nbsp;GB." },
	{ title: "Choose your target size", body: "Pick a one-click preset (8&nbsp;MB for Discord, 25&nbsp;MB for email, 50&nbsp;MB for messaging) and optionally mute audio or keep the source framerate." },
	{ title: "Compress and download", body: "Compression starts automatically. When it finishes, download your optimized MP4, ready to share." },
];
---

<Layout
	title="Video Compressor Online — Reduce Video File Size Free"
	description="Use our fast video compressor online to compress video files and reduce video size without noticeable quality loss. Easily compress MP4 videos for free."
	canonicalURL="https://www.videocompressonline.com/"
	schemas={homepageSchemas}
>
	<Header tone="dark" />

	<!-- ═══════════════════════════════════════ HERO (dark canvas) ═══════════════════════════════════════ -->
	<main class="band-dark starfield relative w-full flex flex-col items-center px-4 pt-16 pb-24 md:pt-24 md:pb-32">
		<Sticker name="bolt" size={104} class="absolute hidden lg:block left-[6%] top-24 -rotate-12" />
		<Sticker name="cone" size={92} class="absolute hidden lg:block right-[7%] top-40 rotate-[10deg]" />

		<div class="relative z-10 w-full max-w-5xl text-center flex flex-col items-center">
			<p class="eyebrow !text-[var(--color-body)] mb-6 inline-flex items-center gap-2">
				<span class="inline-block w-2 h-2 rounded-full bg-[#c2ef4e]" aria-hidden="true"></span>
				Free &middot; Up to 2&nbsp;GB &middot; No watermarks
			</p>

			<h1 class="display-hero text-white mb-6">
				Video Compressor Online<br />
				<span class="chip-lime">Reduce</span> Video Size Easily &amp; Fast
			</h1>

			<p class="body-lg text-[var(--color-body)] max-w-2xl mb-12">
				Free online video compressor to reduce video size and compress MP4, WebM, and MOV files. Perfect for Discord, email, and social sharing with no watermarks.
			</p>

			<!-- ═══════════════════ UPLOADER CARD ═══════════════════ -->
			<div id="compressor" class="card-night w-full max-w-3xl p-3 md:p-6 text-left scroll-mt-24">
				<div
					id="drop-zone"
					class="relative rounded-xl border-2 border-dashed border-[#79628c] bg-[#1f1633] p-6 md:p-12 flex flex-col items-center justify-center cursor-pointer hover:border-white group"
					style="transition: border-color 160ms ease, background-color 160ms ease;"
				>
					<div class="absolute inset-0 rounded-xl bg-[#6a5fc1]/15 opacity-0 pointer-events-none" id="drag-overlay" style="transition: opacity 160ms ease;"></div>

					<div class="flex flex-col items-center text-center z-10">
						<div class="w-14 h-14 rounded-xl bg-white/10 flex items-center justify-center mb-5 text-white" aria-hidden="true">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
							</svg>
						</div>

						<p class="heading-sm text-white mb-1.5">Drag and drop your video</p>
						<p class="text-[14px] text-[var(--color-mute)] mb-7">MP4, WebM, MKV, MOV &middot; up to 2&nbsp;GB</p>

						<label class="btn btn-primary btn-glow">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
							Choose file
							<input type="file" id="file-input" class="hidden" accept="video/*" tabindex="-1" />
						</label>
					</div>
				</div>

				<!-- ═══════════════════ SETTINGS ═══════════════════ -->
				<details class="group mt-3 rounded-xl border border-[#362d59] overflow-hidden" id="target-size-details" name="settings-accordion" open>
					<summary class="flex items-center justify-between px-5 py-4 list-none hover:bg-white/5" style="transition: background-color 120ms ease;">
						<span class="flex items-center gap-2.5 text-[16px] font-semibold text-white">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[#fa7faa]" aria-hidden="true"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
							Compression settings
						</span>
						<span class="flex items-center gap-3">
							<span class="pill font-mono !text-[12px] group-open:hidden">configure</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-mute)] group-open:rotate-180" style="transition: transform 200ms ease;" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
						</span>
					</summary>

					<div class="px-5 md:px-6 py-6 border-t border-[#362d59] space-y-7">
						<div>
							<p class="micro-cap mb-2" id="lbl-target">Target size</p>
							<div class="seg-group" role="group" aria-labelledby="lbl-target">
								<button type="button" class="seg-btn" data-group="target-size" data-value="8">8 MB</button>
								<button type="button" class="seg-btn active" data-group="target-size" data-value="25">25 MB</button>
								<button type="button" class="seg-btn" data-group="target-size" data-value="50">50 MB</button>
								<button type="button" class="seg-btn" data-group="target-size" data-value="100">100 MB</button>
							</div>
							<p class="text-[14px] leading-[1.43] text-[var(--color-mute)] mt-2">The compressor adjusts the bitrate so the output fits under this limit. 8&nbsp;MB suits Discord; 25&nbsp;MB suits email.</p>
						</div>

						<div class="pt-6 border-t border-[#362d59]">
							<p class="micro-cap mb-2">Framerate</p>
							<label class="flex items-center gap-3 cursor-pointer select-none">
								<span class="toggle-switch">
									<input type="checkbox" id="fps-toggle" />
									<span class="slider"></span>
								</span>
								<span class="text-[16px] font-medium text-white">Keep original framerate</span>
							</label>
							<p class="text-[14px] leading-[1.43] text-[var(--color-mute)] mt-2">Off by default: lowering the framerate gives smaller files.</p>
						</div>

						<div class="pt-6 border-t border-[#362d59]">
							<p class="micro-cap mb-2" id="lbl-audio">Audio track</p>
							<div class="seg-group" role="group" aria-labelledby="lbl-audio">
								<button type="button" class="seg-btn active" data-group="audio" data-value="keep">Keep audio</button>
								<button type="button" class="seg-btn" data-group="audio" data-value="remove">Remove audio</button>
							</div>
							<p class="text-[14px] leading-[1.43] text-[var(--color-mute)] mt-2">Removing audio saves space on small targets.</p>
						</div>
					</div>
				</details>
			</div>

			<!-- ═══════════════════ FEATURES ROW ═══════════════════ -->
			<div class="w-full max-w-5xl mt-16 grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
				{features.map((f) => (
					<div class="card-night p-6 md:p-8">
						<div class="w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center text-[#fa7faa] mb-5" aria-hidden="true" set:html={f.icon} />
						<p class="heading-sm text-white mb-2">{f.title}</p>
						<p class="text-[16px] leading-[1.5] text-[var(--color-body)]">{f.body}</p>
					</div>
				))}
			</div>
		</div>
	</main>

	<!-- ═══════════════════ CLOUD SETUP GUIDE MODAL ═══════════════════ -->
	<div id="setup-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4" style="display: none;">
		<div id="setup-modal-backdrop" class="absolute inset-0 bg-[#150f23]/70"></div>
		<div class="band-light relative w-full max-w-lg rounded-xl border border-[var(--color-hairline)] p-6 md:p-8 max-h-[85vh] overflow-y-auto" style="animation: modalIn 200ms ease forwards; box-shadow: rgba(0,0,0,0.1) 0 10px 15px -3px, rgba(0,0,0,0.1) 0 4px 6px -4px;">
			<button id="setup-modal-close" class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full text-[var(--color-mute)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] cursor-pointer" aria-label="Close modal">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
			</button>
			<p class="micro-cap mb-1" id="setup-modal-subtitle">Developer API key needed</p>
			<p class="heading-md text-[var(--color-ink)] mb-5" id="setup-modal-title">Setup required</p>
			<div id="setup-modal-body" class="text-[16px] text-[var(--color-body)] space-y-4"></div>
			<div class="flex items-center gap-3 pt-5 mt-5 border-t border-[var(--color-hairline)]">
				<a id="setup-modal-link" href="#" target="_blank" rel="noopener" class="btn btn-primary flex-1">Open developer portal</a>
				<button id="setup-modal-dismiss" class="btn btn-ghost">Close</button>
			</div>
		</div>
	</div>

	<!-- ═══════════════════════════════════════ SEO CONTENT (light canvas) ═══════════════════════════════════════ -->
	<section class="band-light relative w-full py-16 md:py-24 px-4 md:px-6" id="about">
		<Sticker name="squish" size={128} class="absolute right-[8%] -top-16 rotate-6 hidden md:block" />

		<article class="max-w-3xl mx-auto text-[var(--color-body)]">
			<header class="mb-12">
				<p class="eyebrow mb-3">Why VideoCompressOnline</p>
				<h2 class="display-large text-[var(--color-ink)] mb-6">
					Fast, reliable video compressor online for all your media files
				</h2>
				<p class="body-lg">
					Need to shrink high-resolution footage without sacrificing picture clarity? <strong class="text-[var(--color-ink)] font-semibold">VideoCompressOnline</strong> is a dedicated <strong class="text-[var(--color-ink)] font-semibold">video compressor online</strong> built to make digital video files smaller, faster to send, and easier to store. Whether you need to share game captures on social platforms, send customer walkthroughs over email, or save storage space on your hard drive, our tool helps you <strong class="text-[var(--color-ink)] font-semibold">reduce video size</strong> in seconds without watermarks or complicated software installs.
				</p>
			</header>

			<div class="doc">
				<h2>Why you need to compress video files</h2>
				<p>
					Modern cameras and smartphones record stunning footage, but 4K and 1080p clips create gigantic files that choke messaging channels and upload queues. When you <strong>compress video</strong> files before sharing, you bypass frustrating upload errors and accelerate playback for your audience:
				</p>
				<ul>
					<li><strong>Bypass platform limits:</strong> Messaging apps enforce strict file-size caps. You can easily squeeze clips under Discord’s 8&nbsp;MB limit, WhatsApp’s 16&nbsp;MB ceiling, or standard 25&nbsp;MB email attachment quotas.</li>
					<li><strong>Faster sharing &amp; streaming:</strong> Smaller videos upload faster on cellular connections and stream smoothly without buffering pauses for viewers with modest bandwidth.</li>
					<li><strong>Reclaim storage:</strong> Archiving uncompressed video quickly consumes local storage and cloud subscription space. Compressing your library frees up gigabytes of drive room.</li>
				</ul>

				<h2>How to online reduce video file size in 3 simple steps</h2>
				<p>Our intuitive interface streamlines the entire compression process into three straightforward steps:</p>
			</div>

			<ol class="grid gap-3 mb-4">
				{steps.map((s, i) => (
					<li class="card p-5 md:p-6 flex gap-4">
						<span class="shrink-0 w-9 h-9 rounded-md bg-[var(--color-primary)] text-[var(--color-on-primary)] font-mono font-bold text-[15px] flex items-center justify-center">{i + 1}</span>
						<div>
							<p class="text-[16px] font-semibold text-[var(--color-ink)] mb-1">{s.title}</p>
							<p class="text-[16px] leading-[1.5]" set:html={s.body} />
						</div>
					</li>
				))}
			</ol>

			<div class="doc">
				<h2>Smart encoding: compress MP4 and other formats without quality loss</h2>
				<p>
					Unlike crude tools that simply slash frame resolution or produce pixelated artifacts, this <strong>online video compressor</strong> uses intelligent Constant Rate Factor (CRF) encoding. Our engine analyzes pixel dynamics across adjacent video frames, removing redundant visual data imperceptible to human eyes while retaining edge sharpness and color nuance.
				</p>
				<p>
					Need to <strong>compress MP4</strong>, MOV, WebM, MKV, or AVI footage? Our pipeline supports every major video container and exports cleanly to standard H.264 MP4 with AAC audio. This ensures 100% universal compatibility across iPhones, Android devices, Windows PCs, Mac computers, and modern web browsers.
				</p>

				<h2>Private, secure, and built for files up to 2&nbsp;GB</h2>
				<p>
					Privacy is central to our design. When you <strong>online reduce video file size</strong> with VideoCompressOnline, files are protected with strict TLS/HTTPS encryption. Your files are processed inside isolated worker environments and are never sold, indexed, or viewed. After compression, temporary upload fragments and final output videos are automatically purged within 24 hours.
				</p>
				<p>
					With our 10&nbsp;MB resumable chunked streaming architecture, even 1&nbsp;GB to 2&nbsp;GB video files upload smoothly without browser freezes or out-of-memory errors.
				</p>
			</div>

			<!-- Featured CTA — dark inverted card on light canvas -->
			<div class="band-dark mt-12 rounded-xl p-8 md:p-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 !bg-[#150f23]">
				<div>
					<p class="heading-md text-white">Ready to reduce your video file size?</p>
					<p class="text-[16px] text-[var(--color-body)] mt-1">Free, secure, and ready in seconds. No watermark, no signup.</p>
				</div>
				<a href="#compressor" class="btn btn-primary shrink-0">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
					Compress video now
				</a>
			</div>
		</article>
	</section>

	<!-- ═══════════════════════════════════════ FAQ (light canvas) ═══════════════════════════════════════ -->
	<section class="band-light w-full border-t border-[var(--color-hairline)] py-16 md:py-24 px-4 md:px-6" id="faq">
		<div class="max-w-3xl mx-auto">
			<p class="eyebrow mb-3 text-center">FAQ</p>
			<h2 class="display-large text-[var(--color-ink)] mb-10 text-center">Frequently asked questions</h2>

			<div class="space-y-3">
				{faqs.map((q) => (
					<details class="group card overflow-hidden">
						<summary class="flex items-center justify-between gap-4 px-5 md:px-6 py-5 list-none hover:bg-[var(--color-canvas-soft)]" style="transition: background-color 120ms ease;">
							<h3 class="text-[16px] font-semibold text-[var(--color-ink)] m-0">{q.name}</h3>
							<span class="shrink-0 w-7 h-7 rounded-full border border-[var(--color-hairline-strong)] flex items-center justify-center text-[var(--color-ink)] group-open:rotate-45" style="transition: transform 200ms ease;" aria-hidden="true">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
							</span>
						</summary>
						<div class="px-5 md:px-6 pb-5 text-[16px] leading-[1.75] text-[var(--color-body)]">
							<p>{q.acceptedAnswer.text}</p>
						</div>
					</details>
				))}
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<!-- ═══════════════════════════════════════ STYLES ═══════════════════════════════════════ -->
<style>
	/* Segmented control (always sits on the dark uploader card) */
	.seg-group {
		display: flex;
		gap: 4px;
		padding: 4px;
		border-radius: 8px;
		background-color: #1f1633;
		border: 1px solid #362d59;
	}
	.seg-btn {
		flex: 1;
		min-height: 40px;
		padding: 8px 10px;
		border-radius: 6px;
		font-size: 14px;
		font-weight: 500;
		letter-spacing: 0.2px;
		text-transform: uppercase;
		color: #bdb8c0;
		background: transparent;
		cursor: pointer;
		transition: color 120ms ease, background-color 120ms ease;
	}
	.seg-btn:hover {
		color: #ffffff;
		background-color: rgba(255, 255, 255, 0.06);
	}
	.seg-btn.active {
		color: #1f1633;
		background-color: #ffffff;
		font-weight: 700;
	}

	@keyframes modalIn {
		from { opacity: 0; transform: scale(0.97) translateY(8px); }
		to { opacity: 1; transform: scale(1) translateY(0); }
	}
</style>

<!-- ═══════════════════════════════════════ SCRIPTS ═══════════════════════════════════════ -->
<script>
	// ── Slider ↔ Input Sync (Removed) ──

	// ── Segmented Buttons ──
	document.querySelectorAll('.seg-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			const group = btn.getAttribute('data-group');
			document.querySelectorAll(`.seg-btn[data-group="${group}"]`).forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
		});
	});

	// ── Drag & Drop ──
	const dropZone = document.getElementById('drop-zone');
	const dragOverlay = document.getElementById('drag-overlay');
	const fileInput = document.getElementById('file-input') as HTMLInputElement;

	if (dropZone) {
		['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev => {
			dropZone.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); });
			document.body.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); });
		});

		['dragenter', 'dragover'].forEach(ev => {
			dropZone.addEventListener(ev, () => {
				dropZone.style.borderColor = '#ffffff';
				if (dragOverlay) dragOverlay.style.opacity = '1';
			});
		});

		['dragleave', 'drop'].forEach(ev => {
			dropZone.addEventListener(ev, () => {
				dropZone.style.borderColor = '';
				if (dragOverlay) dragOverlay.style.opacity = '0';
			});
		});

		dropZone.addEventListener('drop', (e: DragEvent) => {
			if (e.dataTransfer?.files) handleFiles(e.dataTransfer.files);
		});
	}

	fileInput?.addEventListener('change', function() { if (this.files) handleFiles(this.files); });


	// ─── High-Performance FFmpeg Compression Engine & Hybrid Architecture ───
	import { FFmpeg } from '@ffmpeg/ffmpeg';

	let isProcessing = false;
	let ffmpegInstance: FFmpeg | null = null;
	let isEngineLoading = false;
	let isEngineLoaded = false;
	let engineLoadPromise: Promise<FFmpeg> | null = null;
	let activeBlobUrl: string | null = null;

	const isSharedArrayBufferSupported = typeof SharedArrayBuffer !== 'undefined';
	const isCrossOriginIsolated = (globalThis as any).crossOriginIsolated === true;

	function formatBytes(bytes: number, decimals = 2): string {
		if (bytes <= 0) return '0 B';
		const k = 1024;
		const dm = decimals < 0 ? 0 : decimals;
		const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
		const i = Math.floor(Math.log(bytes) / Math.log(k));
		return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
	}

	function formatSeconds(sec: number): string {
		if (!isFinite(sec) || sec <= 0) return '00:00';
		const m = Math.floor(sec / 60);
		const s = Math.floor(sec % 60);
		return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
	}

	function formatEta(seconds: number): string {
		if (!isFinite(seconds) || seconds <= 0) return 'Estimating…';
		if (seconds < 60) return `About ${Math.ceil(seconds)}s remaining`;
		const mins = Math.floor(seconds / 60);
		const secs = Math.ceil(seconds % 60);
		return `About ${mins}m ${secs}s remaining`;
	}

	function showError(zone: HTMLElement, title: string, detail: string) {
		zone.style.borderColor = '#fa7faa';
		zone.innerHTML = `
			<div class="flex flex-col items-center z-10 relative text-center max-w-md py-4">
				<div class="w-14 h-14 rounded-xl bg-[#fa7faa] flex items-center justify-center mb-5">
					<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#150f23" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="7" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
				</div>
				<h3 class="heading-md text-white mb-2">${title}</h3>
				<p class="text-[16px] text-[var(--color-body)] mb-6 leading-[1.5] px-4">${detail}</p>
				<button class="btn btn-primary" onclick="location.reload()">Try again</button>
			</div>
		`;
	}

	// ─── Browser Cache API for Instant Sub-50ms Engine Loading ───
	async function getCachedBlobURL(url: string, mimeType: string): Promise<string> {
		const cacheName = 'vco-ffmpeg-cache-v0.12.10';
		if ('caches' in window) {
			try {
				const cache = await caches.open(cacheName);
				let res = await cache.match(url);
				if (!res) {
					res = await fetch(url);
					if (res.ok) {
						cache.put(url, res.clone()).catch(() => {});
					}
				}
				const blob = await res.blob();
				return URL.createObjectURL(new Blob([blob], { type: mimeType }));
			} catch (e) {
				console.warn('Cache API read failed, fetching directly:', e);
			}
		}
		const res = await fetch(url);
		const blob = await res.blob();
		return URL.createObjectURL(new Blob([blob], { type: mimeType }));
	}

	// ─── FFmpeg Engine Loader with Multi-Threading & Cache ───
	async function getFFmpegEngine(onStatus?: (msg: string) => void): Promise<FFmpeg> {
		if (ffmpegInstance && isEngineLoaded) {
			return ffmpegInstance;
		}
		if (engineLoadPromise) {
			return engineLoadPromise;
		}

		engineLoadPromise = (async () => {
			isEngineLoading = true;
			const ffmpeg = new FFmpeg();
			const CDNs = [
				'https://unpkg.com',
				'https://cdn.jsdelivr.net/npm',
			];

			let loaded = false;
			let lastErr: any = null;

			for (const cdn of CDNs) {
				if (loaded) break;
				// 1. Multi-threaded core (PThreads + SharedArrayBuffer for 3-4x encoding speed)
				if (isCrossOriginIsolated && isSharedArrayBufferSupported) {
					try {
						onStatus?.('Loading multi-threaded WebAssembly engine…');
						const base = `${cdn}/@ffmpeg/core-mt@0.12.10/dist/esm`;
						const [coreURL, wasmURL, workerURL] = await Promise.all([
							getCachedBlobURL(`${base}/ffmpeg-core.js`, 'text/javascript'),
							getCachedBlobURL(`${base}/ffmpeg-core.wasm`, 'application/wasm'),
							getCachedBlobURL(`${base}/ffmpeg-core.worker.js`, 'text/javascript'),
						]);
						await ffmpeg.load({ coreURL, wasmURL, workerURL });
						loaded = true;
						console.log(`✓ FFmpeg multi-threaded core initialized from ${cdn}`);
						break;
					} catch (e) {
						console.warn(`Multi-threaded core from ${cdn} failed:`, e);
						lastErr = e;
					}
				}

				// 2. Single-threaded core fallback
				try {
					onStatus?.('Loading WebAssembly engine…');
					const base = `${cdn}/@ffmpeg/core@0.12.10/dist/esm`;
					const [coreURL, wasmURL] = await Promise.all([
						getCachedBlobURL(`${base}/ffmpeg-core.js`, 'text/javascript'),
						getCachedBlobURL(`${base}/ffmpeg-core.wasm`, 'application/wasm'),
					]);
					await ffmpeg.load({ coreURL, wasmURL });
					loaded = true;
					console.log(`✓ FFmpeg single-threaded core initialized from ${cdn}`);
					break;
				} catch (e) {
					console.warn(`Single-threaded core from ${cdn} failed:`, e);
					lastErr = e;
				}
			}

			if (!loaded) {
				isEngineLoading = false;
				engineLoadPromise = null;
				throw (lastErr || new Error('Failed to load WebAssembly engine from CDN.'));
			}

			ffmpegInstance = ffmpeg;
			isEngineLoaded = true;
			isEngineLoading = false;
			return ffmpeg;
		})();

		return engineLoadPromise;
	}

	// ─── Background Prewarm on User Interaction (Zero Impact on Initial Page Load) ───
	function prewarmEngine() {
		if (isEngineLoaded || isEngineLoading) return;
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(() => getFFmpegEngine().catch(() => {}));
		} else {
			setTimeout(() => getFFmpegEngine().catch(() => {}), 1000);
		}
	}

	dropZone?.addEventListener('mouseenter', prewarmEngine, { once: true });
	dropZone?.addEventListener('dragenter', prewarmEngine, { once: true });

	// ─── Fast Non-Blocking Video Metadata Extraction (HTML5 <video> Element) ───
	interface VideoMetadata {
		duration: number;
		width: number;
		height: number;
		hasMotion: boolean;
		estimatedBitrate: number;
	}

	function extractVideoMetadata(file: File): Promise<VideoMetadata> {
		return new Promise((resolve) => {
			const video = document.createElement('video');
			video.preload = 'metadata';
			const objectUrl = URL.createObjectURL(file);
			video.src = objectUrl;

			const cleanup = () => {
				URL.revokeObjectURL(objectUrl);
				video.remove();
			};

			const timer = setTimeout(() => {
				cleanup();
				resolve({
					duration: 60,
					width: 1920,
					height: 1080,
					hasMotion: true,
					estimatedBitrate: 2500,
				});
			}, 3000);

			video.onloadedmetadata = () => {
				clearTimeout(timer);
				const duration = video.duration && isFinite(video.duration) && video.duration > 0 ? video.duration : 60;
				const width = video.videoWidth || 1920;
				const height = video.videoHeight || 1080;
				cleanup();

				// Zero-delay bitrate-per-pixel motion detection heuristic
				const estimatedBitrate = Math.round((file.size * 8) / duration / 1000);
				const pixelCount = width * height;
				const bitratePerPixel = pixelCount > 0 ? (estimatedBitrate / pixelCount) * 1000 : 0.05;
				const hasMotion = bitratePerPixel > 0.1 || estimatedBitrate > 3000;

				resolve({ duration, width, height, hasMotion, estimatedBitrate });
			};

			video.onerror = () => {
				clearTimeout(timer);
				cleanup();
				resolve({
					duration: 60,
					width: 1920,
					height: 1080,
					hasMotion: true,
					estimatedBitrate: 2500,
				});
			};
		});
	}

	// ─── Target Resolution & Scaling Calculator ───
	function calculateResolution(width: number, height: number, targetSizeMB: number, hasMotion: boolean) {
		let maxWidth = width;
		if (targetSizeMB <= 8) {
			maxWidth = hasMotion ? 1024 : 854;
		} else if (targetSizeMB <= 25) {
			maxWidth = hasMotion ? 1440 : 1280;
		} else if (targetSizeMB <= 50) {
			maxWidth = 1920;
		}

		if (width > maxWidth && height > 0) {
			const aspect = width / height;
			let newWidth = maxWidth;
			let newHeight = Math.round(newWidth / aspect);
			if (newWidth % 2 !== 0) newWidth--;
			if (newHeight % 2 !== 0) newHeight--;
			return {
				width: newWidth,
				height: newHeight,
				scaleFilter: `scale=${newWidth}:${newHeight}:flags=fast_bilinear`,
			};
		}
		return { width, height, scaleFilter: null };
	}

	// ─── Main File Handler: Smart Hybrid Pipeline ───
	async function handleFiles(files: FileList) {
		if (files.length === 0) return;
		if (isProcessing) {
			alert('A video is already being processed. Please wait.');
			return;
		}

		const file = files[0];
		const maxAllowed = 2 * 1024 * 1024 * 1024; // 2 GB hard limit

		const dropZone = document.getElementById('drop-zone');
		if (!dropZone) return;

		if (file.size > maxAllowed) {
			showError(
				dropZone,
				'File Too Large',
				`Your video is ${formatBytes(file.size)}. The maximum supported video size is 2 GB. Please select a video up to 2 GB.`
			);
			return;
		}

		if (file.size < 1024) {
			showError(
				dropZone,
				'Invalid File',
				'The selected file is too small or empty. Please select a valid video.'
			);
			return;
		}

		// Read user options
		const targetBtn = document.querySelector<HTMLElement>('.seg-btn.active[data-group="target-size"]');
		const audioBtn  = document.querySelector<HTMLElement>('.seg-btn.active[data-group="audio"]');
		const fpsToggle = document.getElementById('fps-toggle') as HTMLInputElement | null;
		const targetSizeMB = parseFloat(targetBtn?.getAttribute('data-value') || '25');
		const keepAudio    = audioBtn?.getAttribute('data-value') !== 'remove';
		const keepFps      = !!fpsToggle?.checked;

		isProcessing = true;

		// Revoke previous blob URL if any
		if (activeBlobUrl) {
			URL.revokeObjectURL(activeBlobUrl);
			activeBlobUrl = null;
		}

		// Initial preparation card
		dropZone.style.borderColor = 'var(--primary)';
		dropZone.style.backgroundColor = 'var(--canvas)';
		dropZone.innerHTML = `
			<div class="flex flex-col items-center w-full max-w-md py-2 z-10 relative">
				<div class="w-11 h-11 rounded-full border-[3px] border-[#362d59] border-t-[#fa7faa] animate-spin mb-4" id="status-spinner"></div>
				<h3 class="heading-md text-white mb-1" id="process-title">Analyzing video…</h3>
				<p class="text-[14px] text-[var(--color-mute)] mb-6 max-w-sm truncate text-center" id="process-subtitle">${file.name} · ${formatBytes(file.size)}</p>

				<div class="w-full h-2 bg-[#150f23] rounded-full overflow-hidden border border-[#362d59] relative mb-3" role="progressbar" aria-label="Compression progress">
					<div class="absolute top-0 left-0 h-full bg-[#fa7faa] rounded-full" id="main-progress-bar" style="width: 2%; transition: width 0.2s ease;"></div>
				</div>

				<div class="w-full flex items-center justify-between font-mono text-white mb-4">
					<span id="progress-pct" class="font-bold text-[16px]">0%</span>
					<span id="progress-mode" class="text-[14px] text-[var(--color-mute)]">Analyzing stream</span>
				</div>

				<div class="w-full grid grid-cols-2 gap-3 bg-[#150f23] border border-[#362d59] rounded-lg p-4 mb-4" id="speed-eta-panel">
					<div class="flex flex-col text-left">
						<span class="micro-cap">Speed / status</span>
						<span class="font-mono text-[14px] text-white" id="process-speed">Preparing…</span>
					</div>
					<div class="flex flex-col text-right">
						<span class="micro-cap">Time remaining</span>
						<span class="font-mono text-[14px] text-white" id="process-eta">Estimating…</span>
					</div>
				</div>

				<p class="text-[14px] text-[var(--color-mute)] text-center" id="status-detail">
					Extracting video duration and resolution…
				</p>
			</div>
		`;

		const titleEl = document.getElementById('process-title');
		const subtitleEl = document.getElementById('process-subtitle');
		const progressBar = document.getElementById('main-progress-bar') as HTMLElement | null;
		const pctEl = document.getElementById('progress-pct');
		const modeEl = document.getElementById('progress-mode');
		const speedEl = document.getElementById('process-speed');
		const etaEl = document.getElementById('process-eta');
		const detailEl = document.getElementById('status-detail');

		// ── Step 1: Instant Native Metadata Extraction ──
		const metadata = await extractVideoMetadata(file);

		// ── Step 2: Intelligent Hybrid Routing Decision ──
		// Files <= 500 MB are compressed 100% inside the browser using WebAssembly.
		// Files > 500 MB (up to 2 GB) use resilient chunked streaming to prevent 32-bit WASM memory exhaustion.
		const CLIENT_WASM_MAX_SIZE = 500 * 1024 * 1024; // 500 MB

		if (file.size <= CLIENT_WASM_MAX_SIZE) {
			try {
				await runBrowserCompression(file, targetSizeMB, keepAudio, keepFps, metadata, dropZone, {
					titleEl, subtitleEl, progressBar, pctEl, modeEl, speedEl, etaEl, detailEl
				});
				return;
			} catch (browserErr: any) {
				console.warn('Browser WebAssembly compression failed, automatically falling back to resilient server stream:', browserErr);
				// Fallback seamlessly to chunked upload pipeline
			}
		}

		// Run Large Video Chunked Streaming Pipeline (> 500 MB or WASM fallback)
		await runServerStreamingPipeline(file, targetSizeMB, keepAudio, keepFps, dropZone, {
			titleEl, subtitleEl, progressBar, pctEl, modeEl, speedEl, etaEl, detailEl
		});
	}

	// ─── Pipeline A: In-Browser WebAssembly Compression Engine ───
	async function runBrowserCompression(
		file: File,
		targetSizeMB: number,
		keepAudio: boolean,
		keepFps: boolean,
		metadata: VideoMetadata,
		dropZone: HTMLElement,
		ui: any
	) {
		if (ui.titleEl) ui.titleEl.textContent = 'Preparing compression engine…';
		if (ui.modeEl) ui.modeEl.textContent = '100% Client-Side Engine';
		if (ui.detailEl) ui.detailEl.textContent = 'Loading WebAssembly FFmpeg worker & mounting file…';

		// 1. Initialize FFmpeg with Cache API
		const ffmpeg = await getFFmpegEngine((msg) => {
			if (ui.detailEl) ui.detailEl.textContent = msg;
		});

		const threadCount = isCrossOriginIsolated ? Math.min(navigator.hardwareConcurrency || 2, 4) : 1;

		// 2. Zero-Copy File Input Mounting via WORKERFS
		const inputDir = '/vco_input_' + Date.now();
		const cleanName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
		const inputPath = `${inputDir}/${cleanName}`;
		let usedWorkerFS = false;

		try {
			await ffmpeg.createDir(inputDir);
			await ffmpeg.mount('WORKERFS' as any, { files: [file] }, inputDir);
			usedWorkerFS = true;
		} catch (mountErr) {
			console.warn('WORKERFS direct mount unavailable, falling back to MEMFS:', mountErr);
			// Fallback to MEMFS with transferable buffer
			const arrayBuf = await file.arrayBuffer();
			await ffmpeg.writeFile(cleanName, new Uint8Array(arrayBuf));
		}

		const finalInput = usedWorkerFS ? inputPath : cleanName;
		const outputPath = `compressed_${Date.now()}.mp4`;

		// 3. Motion-Aware Bitrate & VBV Budget Calculation
		const efficiency = metadata.hasMotion ? 0.80 : 0.85;
		const totalBudgetBits = (targetSizeMB * 1024 * 1024 * 8) * efficiency;
		const targetBitrateBps = totalBudgetBits / metadata.duration;
		const audioBitrateBps = keepAudio ? Math.min(128_000, Math.round(targetBitrateBps * 0.12)) : 0;
		const videoBitrateBps = Math.max(150_000, targetBitrateBps - audioBitrateBps);
		const videoKbps = Math.max(150, Math.round(videoBitrateBps / 1000));
		const audioKbps = keepAudio ? Math.max(32, Math.round(audioBitrateBps / 1000)) : 0;

		const crf = targetSizeMB <= 8 ? (metadata.hasMotion ? 24 : 26)
		          : targetSizeMB <= 25 ? (metadata.hasMotion ? 22 : 24)
		          : targetSizeMB <= 50 ? (metadata.hasMotion ? 20 : 22)
		          : 20;

		// 4. Intelligent Resolution Downscaling
		const scaleInfo = calculateResolution(metadata.width, metadata.height, targetSizeMB, metadata.hasMotion);

		// 5. Build High-Performance WebAssembly FFmpeg Arguments
		const args = [
			'-y',
			'-i', finalInput,
			'-c:v', 'libx264',
			'-preset', 'veryfast',
			'-tune', 'film',
			'-crf', String(crf),
			'-b:v', `${videoKbps}k`,
			'-maxrate', `${Math.max(1, Math.round(videoKbps * 1.2))}k`,
			'-bufsize', `${metadata.hasMotion ? Math.round(videoKbps * 3) : Math.round(videoKbps * 2)}k`,
			'-refs', '1',
			'-bf', '0',
			'-threads', String(threadCount),
			'-me_method', 'hex',
			'-subq', '3',
			'-pix_fmt', 'yuv420p',
		];

		if (scaleInfo.scaleFilter) {
			args.push('-vf', scaleInfo.scaleFilter);
		}

		if (keepAudio) {
			args.push('-c:a', 'aac', '-b:a', `${audioKbps}k`);
		} else {
			args.push('-an');
		}

		if (!keepFps) {
			const fpsCap = targetSizeMB <= 8 ? 24 : 30;
			args.push('-r', String(fpsCap));
		}

		args.push('-movflags', '+faststart', outputPath);

		if (ui.titleEl) ui.titleEl.textContent = 'Compressing video…';
		if (ui.subtitleEl) ui.subtitleEl.textContent = `Target: ${targetSizeMB} MB · ${scaleInfo.width}x${scaleInfo.height} · ${keepAudio ? 'Audio kept' : 'No audio'}`;
		if (ui.detailEl) ui.detailEl.textContent = 'Processing video frames in browser memory…';

		// 6. Throttled Progress Listener (8-10 updates per second)
		const startTime = performance.now();
		let lastUiUpdate = startTime;
		let lastProgressPct = 0;

		const progressHandler = ({ progress, time }: { progress: number; time: number }) => {
			const now = performance.now();
			if (now - lastUiUpdate < 120) return; // 120ms throttle (~8 fps UI updates)
			lastUiUpdate = now;

			let pct = Math.round(progress * 100);
			if (!isFinite(pct) || pct < 0) {
				const timeSec = time / 1_000_000;
				pct = metadata.duration > 0 ? Math.min(99, Math.round((timeSec / metadata.duration) * 100)) : 0;
			}
			pct = Math.max(1, Math.min(99, pct));
			lastProgressPct = pct;

			if (ui.progressBar) ui.progressBar.style.width = `${pct}%`;
			if (ui.pctEl) ui.pctEl.textContent = `${pct}%`;

			const elapsedSec = (now - startTime) / 1000;
			if (pct > 3 && elapsedSec > 0.5) {
				const rate = pct / elapsedSec;
				const remainingSec = (100 - pct) / rate;
				if (ui.etaEl) ui.etaEl.textContent = formatEta(remainingSec);
				if (ui.speedEl) {
					const fps = Math.round((metadata.duration * 30 * (pct / 100)) / elapsedSec);
					ui.speedEl.textContent = fps > 0 ? `${fps} fps` : `${rate.toFixed(1)}%/s`;
				}
			}
		};

		ffmpeg.on('progress', progressHandler);

		try {
			const exitCode = await ffmpeg.exec(args);
			ffmpeg.off('progress', progressHandler);

			if (exitCode !== 0) {
				throw new Error(`FFmpeg exited with code ${exitCode}`);
			}

			if (ui.titleEl) ui.titleEl.textContent = 'Finalizing video…';
			if (ui.detailEl) ui.detailEl.textContent = 'Transferring output and preparing download…';

			// 7. Output Retrieval & Immediate Memory Cleanup
			const outData = (await ffmpeg.readFile(outputPath)) as Uint8Array;
			if (!outData || outData.byteLength < 1024) {
				throw new Error('Encoding completed but output video file is empty.');
			}

			// Clean up virtual filesystem immediately to prevent memory leaks
			try {
				if (usedWorkerFS) {
					await ffmpeg.unmount(inputDir);
					await ffmpeg.deleteDir(inputDir);
				} else {
					await ffmpeg.deleteFile(cleanName);
				}
				await ffmpeg.deleteFile(outputPath);
			} catch (fsErr) {
				console.warn('Non-fatal cleanup notice:', fsErr);
			}

			const outBlob = new Blob([outData.buffer], { type: 'video/mp4' });
			const downloadUrl = URL.createObjectURL(outBlob);
			activeBlobUrl = downloadUrl;

			const originalSizeStr = formatBytes(file.size);
			const compressedSizeStr = formatBytes(outBlob.size);
			const savingsPct = Math.max(1, Math.round((1 - outBlob.size / file.size) * 100));
			const downloadName = `compressed_${file.name.replace(/\.[^/.]+$/, '')}.mp4`;

			// 8. Render Completion Card
			dropZone.innerHTML = `
				<div class="flex flex-col items-center z-10 relative py-2">
					<div class="w-14 h-14 rounded-xl bg-[#c2ef4e] flex items-center justify-center mb-5">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1f1633" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
					</div>
					<h3 class="heading-md text-white mb-3">Compression complete</h3>
					<div class="flex flex-wrap items-center justify-center gap-2 mb-8">
						<span class="pill font-mono">${originalSizeStr} &rarr; <strong class="font-bold text-white">${compressedSizeStr}</strong></span>
						<span class="pill font-mono !bg-[#c2ef4e] !text-[#1f1633] font-bold">${savingsPct}% smaller</span>
					</div>

					<a href="${downloadUrl}" download="${downloadName}" class="btn btn-primary btn-glow">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
						Download video
					</a>
					<button class="btn btn-ghost mt-3" onclick="location.reload()">
						Compress another file
					</button>
				</div>
			`;
			isProcessing = false;
		} catch (err) {
			ffmpeg.off('progress', progressHandler);
			throw err;
		}
	}

	// ─── Pipeline B: Resilient Chunked Streaming Pipeline (> 500 MB & Fallback) ───
	async function runServerStreamingPipeline(
		file: File,
		targetSizeMB: number,
		keepAudio: boolean,
		keepFps: boolean,
		dropZone: HTMLElement,
		ui: any
	) {
		const abortController = new AbortController();
		let activeUploadId: string | null = null;
		let isCancelled = false;

		if (ui.titleEl) ui.titleEl.textContent = 'Uploading large video…';
		if (ui.modeEl) ui.modeEl.textContent = 'Chunked Streaming Pipeline';
		if (ui.detailEl) ui.detailEl.textContent = 'Initializing resilient 10 MB chunk upload session…';

		try {
			const initRes = await fetch('/api/upload/init', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				signal: abortController.signal,
				body: JSON.stringify({
					fileName: file.name,
					fileSize: file.size,
					fileType: file.type || 'video/mp4',
					settings: { targetSizeMB, keepAudio, keepFps },
				}),
			});

			if (!initRes.ok) {
				const errData = await initRes.json().catch(() => ({}));
				throw new Error(errData.error || `Upload initialization failed (${initRes.status})`);
			}

			const { uploadId, chunkSize, totalChunks } = await initRes.json();
			activeUploadId = uploadId;

			const CONCURRENCY = 2;
			const chunkBytesUploaded = new Array(totalChunks).fill(0);
			let totalUploadedBytes = 0;
			const startTime = performance.now();
			let lastSpeedCalcTime = startTime;
			let lastSpeedCalcBytes = 0;
			let currentSpeedBps = 0;

			async function uploadSingleChunk(index: number, maxRetries = 4): Promise<void> {
				if (isCancelled) return;
				const start = index * chunkSize;
				const end = Math.min(start + chunkSize, file.size);
				const chunkBlob = file.slice(start, end);
				const expectedSize = end - start;

				let attempt = 0;
				while (attempt < maxRetries) {
					if (isCancelled) return;
					try {
						const res = await fetch('/api/upload/chunk', {
							method: 'POST',
							signal: abortController.signal,
							headers: {
								'Content-Type': 'application/octet-stream',
								'X-Upload-Id': uploadId,
								'X-Chunk-Index': String(index),
							},
							body: chunkBlob,
						});

						if (!res.ok) {
							const errJson = await res.json().catch(() => ({}));
							throw new Error(errJson.error || `HTTP ${res.status}`);
						}

						chunkBytesUploaded[index] = expectedSize;
						return;
					} catch (err: any) {
						if (isCancelled || err?.name === 'AbortError') return;
						attempt++;
						if (attempt >= maxRetries) {
							throw new Error(`Upload error on chunk ${index + 1}/${totalChunks}: ${err?.message || 'Network failure'}`);
						}
						const backoff = Math.min(1000 * Math.pow(2, attempt - 1), 4000);
						if (ui.detailEl) ui.detailEl.textContent = `Network glitch on chunk ${index + 1}. Retrying in ${backoff / 1000}s…`;
						await new Promise((r) => setTimeout(r, backoff));
					}
				}
			}

			const progressTicker = setInterval(() => {
				if (isCancelled) return;
				totalUploadedBytes = chunkBytesUploaded.reduce((a, b) => a + b, 0);
				const now = performance.now();
				const elapsedWindowSec = (now - lastSpeedCalcTime) / 1000;
				if (elapsedWindowSec >= 0.4) {
					const bytesInWindow = totalUploadedBytes - lastSpeedCalcBytes;
					currentSpeedBps = bytesInWindow / elapsedWindowSec;
					lastSpeedCalcTime = now;
					lastSpeedCalcBytes = totalUploadedBytes;
				}

				const pct = Math.min(99, Math.round((totalUploadedBytes / file.size) * 100));
				if (ui.progressBar) ui.progressBar.style.width = `${pct}%`;
				if (ui.pctEl) ui.pctEl.textContent = `${pct}%`;
				if (ui.speedEl) ui.speedEl.textContent = `${(currentSpeedBps / (1024 * 1024)).toFixed(1)} MB/s`;

				if (ui.etaEl) {
					if (currentSpeedBps > 50_000) {
						const remainingBytes = Math.max(0, file.size - totalUploadedBytes);
						ui.etaEl.textContent = formatEta(remainingBytes / currentSpeedBps);
					} else {
						ui.etaEl.textContent = 'Estimating…';
					}
				}
			}, 200);

			let nextChunkIdx = 0;
			async function worker(): Promise<void> {
				while (nextChunkIdx < totalChunks && !isCancelled) {
					const idx = nextChunkIdx++;
					await uploadSingleChunk(idx);
				}
			}

			const workers = Array.from({ length: Math.min(CONCURRENCY, totalChunks) }, () => worker());
			await Promise.all(workers);
			clearInterval(progressTicker);

			if (isCancelled) return;

			if (ui.titleEl) ui.titleEl.textContent = 'Upload complete!';
			if (ui.detailEl) ui.detailEl.textContent = 'Reassembling video streams & preparing native encoder…';

			const completeRes = await fetch('/api/upload/complete', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				signal: abortController.signal,
				body: JSON.stringify({
					uploadId,
					settings: { targetSizeMB, keepAudio, keepFps },
				}),
			});

			if (!completeRes.ok) {
				const errData = await completeRes.json().catch(() => ({}));
				throw new Error(errData.error || 'Failed to assemble video on server.');
			}

			const { jobId } = await completeRes.json();

			if (ui.titleEl) ui.titleEl.textContent = 'Compressing video…';
			if (ui.subtitleEl) ui.subtitleEl.textContent = `Target: ${targetSizeMB} MB · Native H.264 Encoder`;
			if (ui.progressBar) ui.progressBar.style.width = '2%';
			if (ui.pctEl) ui.pctEl.textContent = '0%';
			if (ui.detailEl) ui.detailEl.textContent = 'Encoding video frames with native H.264 veryfast…';

			while (!isCancelled) {
				await new Promise((r) => setTimeout(r, 1000));

				const jobRes = await fetch(`/api/jobs/${jobId}`);
				if (!jobRes.ok) continue;

				const job = await jobRes.json();

				if (job.status === 'completed') {
					const originalSizeStr = formatBytes(job.originalSize);
					const compressedSizeStr = formatBytes(job.compressedSize);
					const savingsPct = Math.max(1, Math.round((1 - job.compressedSize / job.originalSize) * 100));

					dropZone.innerHTML = `
						<div class="flex flex-col items-center z-10 relative py-2">
							<div class="w-14 h-14 rounded-xl bg-[#c2ef4e] flex items-center justify-center mb-5">
								<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1f1633" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
							</div>
							<h3 class="heading-md text-white mb-3">Compression complete</h3>
							<div class="flex flex-wrap items-center justify-center gap-2 mb-8">
								<span class="pill font-mono">${originalSizeStr} &rarr; <strong class="font-bold text-white">${compressedSizeStr}</strong></span>
								<span class="pill font-mono !bg-[#c2ef4e] !text-[#1f1633] font-bold">${savingsPct}% smaller</span>
							</div>

							<a href="${job.downloadUrl}" class="btn btn-primary btn-glow">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
								Download video
							</a>
							<button class="btn btn-ghost mt-3" onclick="location.reload()">
								Compress another file
							</button>
						</div>
					`;
					isProcessing = false;
					return;
				}

				if (job.status === 'failed') {
					throw new Error(job.error || 'Compression failed.');
				}

				const compPct = Math.min(99, Math.max(2, job.progress || 2));
				if (ui.progressBar) ui.progressBar.style.width = `${compPct}%`;
				if (ui.pctEl) ui.pctEl.textContent = `${compPct}%`;
				if (ui.detailEl && job.statusText) ui.detailEl.textContent = job.statusText;
			}
		} catch (err: any) {
			if (isCancelled || err?.name === 'AbortError') return;
			console.error('Processing error:', err);
			showError(dropZone, 'Compression Failed', err?.message || 'An unexpected error occurred during processing. Please try again.');
			isProcessing = false;
		}
	}
</script>

