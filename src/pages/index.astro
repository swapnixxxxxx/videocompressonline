<!-- ═══════════════════════════════════════ SCRIPTS ═══════════════════════════════════════ -->
<script>
	// ── Theme Toggle ──
	const themeBtn = document.getElementById('theme-toggle');
	const iconMoon = document.getElementById('icon-moon');
	const iconSun = document.getElementById('icon-sun');
	const themeLabel = document.getElementById('theme-label');

	function syncThemeUI() {
		const isDark = document.documentElement.classList.contains('dark');
		if (iconMoon && iconSun && themeLabel) {
			iconMoon.style.opacity = isDark ? '0' : '1';
			iconMoon.style.transform = isDark ? 'rotate(-90deg) scale(0)' : 'rotate(0) scale(1)';
			iconSun.style.opacity = isDark ? '1' : '0';
			iconSun.style.transform = isDark ? 'rotate(0) scale(1)' : 'rotate(90deg) scale(0)';
			themeLabel.textContent = isDark ? 'Light' : 'Dark';
		}
	}
	syncThemeUI();

	themeBtn?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.contains('dark');
		document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'light' : 'dark');
		syncThemeUI();
	});


	// ── Slider ↔ Input Sync (Removed) ──

	// ── Segmented Buttons ──
	document.querySelectorAll('.seg-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			const group = btn.getAttribute('data-group');
			document.querySelectorAll(`.seg-btn[data-group="${group}"]`).forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
		});
	});

	// ── Drag & Drop ──
	const dropZone = document.getElementById('drop-zone');
	const dragOverlay = document.getElementById('drag-overlay');
	const fileInput = document.getElementById('file-input') as HTMLInputElement;

	if (dropZone) {
		['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev => {
			dropZone.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); });
			document.body.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); });
		});

		['dragenter', 'dragover'].forEach(ev => {
			dropZone.addEventListener(ev, () => {
				dropZone.style.borderColor = 'var(--ink)';
				if (dragOverlay) dragOverlay.style.opacity = '1';
			});
		});

		['dragleave', 'drop'].forEach(ev => {
			dropZone.addEventListener(ev, () => {
				dropZone.style.borderColor = '';
				if (dragOverlay) dragOverlay.style.opacity = '0';
			});
		});

		dropZone.addEventListener('drop', (e: DragEvent) => {
			if (e.dataTransfer?.files) handleFiles(e.dataTransfer.files);
		});
	}

	fileInput?.addEventListener('change', function() { if (this.files) handleFiles(this.files); });


	// ── FFmpeg Integration ──
	import { FFmpeg } from '@ffmpeg/ffmpeg';
	import { fetchFile, toBlobURL } from '@ffmpeg/util';

	const ffmpeg = new FFmpeg();
	let isCompressing = false;

	async function handleFiles(files: FileList) {
		if (files.length === 0) return;
		if (isCompressing) {
			alert('Already compressing a video. Please wait.');
			return;
		}

		const file = files[0];
		const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
		console.log('Starting compression:', file.name, `${sizeMB} MB`);
		
		if (file.size > 5 * 1024 * 1024 * 1024) {
			return;
		}

		isCompressing = true;
		const dropZone = document.getElementById('drop-zone');
		if (!dropZone) return;

		// 1. Show Progress UI
		dropZone.style.borderColor = 'var(--primary)';
		dropZone.style.backgroundColor = 'var(--canvas)';
		dropZone.innerHTML = `
			<div class="flex flex-col items-center w-full max-w-sm py-4 z-10 relative">
				<div class="w-12 h-12 rounded-full border-[3px] border-[var(--color-hairline-strong)] border-t-[var(--color-primary)] animate-spin mb-6"></div>
				<h3 class="text-xl font-bold tracking-tight text-[var(--color-ink)] mb-2">Compressing...</h3>
				<p class="text-sm font-medium text-[var(--color-mute)] mb-8" id="progress-text">Initializing engine</p>
				
				<div class="w-full h-2.5 bg-[var(--color-canvas-soft-2)] rounded-full overflow-hidden shadow-inner border border-[var(--color-hairline)] relative">
					<div class="absolute top-0 left-0 h-full bg-gradient-to-r from-[#007cf0] to-[#00dfd8] rounded-full" id="progress-bar" style="width: 0%; transition: width 0.3s ease;"></div>
				</div>
				<p class="text-xs font-mono text-[var(--color-mute)] mt-3" id="progress">0%</p>
			</div>
		`;

		const progressText = document.getElementById('progress-text');
		const progressBar = document.getElementById('progress-bar');
		const pctText = document.getElementById('pct-text');

		try {
			// 2. Setup Progress Handler
			ffmpeg.on('log', ({ message }) => console.log('FFmpeg:', message));
			ffmpeg.on("progress", ({ progress, time }) => {
			  const percent = Math.round(progress * 100);
			  document.getElementById("progress").textContent = `${percent}%`;
			});

			// 3. Load FFmpeg (multi-threaded core)
			// @ffmpeg/core-mt uses PThreads + SharedArrayBuffer for 2–4× faster
			// encoding than the single-threaded @ffmpeg/core. Requires the
			// page to be cross-origin isolated — see public/_headers (COOP + COEP).
			// Artifacts are CDN-hosted here because the 31 MB wasm exceeds
			// Cloudflare Pages' 25 MB per-file limit, so we can't bundle it.
			if (!ffmpeg.loaded) {
				if (progressText) progressText.innerText = 'Loading WebAssembly engine (~33 MB, one-time)...';
				const CORE_BASE = "https://unpkg.com/@ffmpeg/core-mt@0.12.10/dist/umd";
				const coreURL = await toBlobURL(`${CORE_BASE}/ffmpeg-core.js`, "text/javascript");
				const wasmURL = await toBlobURL(`${CORE_BASE}/ffmpeg-core.wasm`, "application/wasm");
				const workerURL = await toBlobURL(`${CORE_BASE}/ffmpeg-core.worker.js`, "text/javascript");
				await ffmpeg.load({ coreURL, wasmURL, workerURL });
			}

			// 4. Mount the large file efficiently using WORKERFS (or fallback to MEMFS)
			if (progressText) progressText.innerText = 'Mounting file...';
			
			let inputPath = '';
			const inputDir = '/input_' + Date.now();
			let usedWorkerFS = false;
			try {
				await ffmpeg.createDir(inputDir);
				await ffmpeg.mount('WORKERFS' as any, { files: [file] }, inputDir);
				inputPath = `${inputDir}/${file.name}`;
				usedWorkerFS = true;
			} catch (e) {
				console.warn('WORKERFS mount failed, falling back to MEMFS:', e);
				inputPath = `input_${Date.now()}.mp4`;
				const buffer = await fetchFile(file);
				await ffmpeg.writeFile(inputPath, buffer);
			}

			const outputPath = `output_${Date.now()}.mp4`;

			// ── Probe the input for duration + FPS ──
			// ffmpeg.wasm has no separate ffprobe, so we re-run ffmpeg with a
			// NULL muxer and read the metadata it prints to stderr (captured by
			// the 'log' event). A non-zero exit here is normal — we ignore it.
			if (progressText) progressText.innerText = 'Analyzing video…';
			let probeDuration = 0;   // seconds; 0 means "unknown"
			let probeFps = 30;       // fallback FPS for the rare case the log
			                        //   doesn't include an fps line
			const probeHandler = ({ message }: { message: string }) => {
				const dm = message.match(/Duration:\s*(\d+):(\d{1,2}):(\d+(?:\.\d+)?)/);
				if (dm) {
					const d = (+dm[1]) * 3600 + (+dm[2]) * 60 + parseFloat(dm[3]);
					if (d > 0) probeDuration = d;
				}
				const fm = message.match(/(\d+(?:\.\d+)?)\s*fps\b/);
				if (fm) {
					const v = parseFloat(fm[1]);
					if (v > 0 && v <= 240) probeFps = v;
				}
			};
			ffmpeg.on('log', probeHandler);
			try {
				await ffmpeg.exec(['-hide_banner', '-i', inputPath, '-f', 'null', '-']);
			} catch { /* expected on null output */ }
			ffmpeg.off('log', probeHandler);

			// ── Read the UI's chosen settings ──
			const targetBtn = document.querySelector<HTMLElement>('.seg-btn.active[data-group="target-size"]');
			const audioBtn = document.querySelector<HTMLElement>('.seg-btn.active[data-group="audio"]');
			const fpsToggle = document.getElementById('fps-toggle') as HTMLInputElement | null;
			const targetSizeMB = parseFloat(targetBtn?.getAttribute('data-value') || '25');
			const keepAudio = audioBtn?.getAttribute('data-value') !== 'remove';
			const keepFps = !!fpsToggle?.checked;

			// ── Per-preset CRF (quality floor) ──
			// Tighter targets get a higher CRF (more compression accepted).
			// Combined with -b:v below, this gives libx264 both a quality
			// floor and a bitrate cap — when the cap binds, you still get
			// consistent quality; when the clip is short and the cap is
			// generous, CRF keeps the file tight.
			const CRF_TABLE: Record<string, number> = {
				"8":   26, // small budget → heavier compression accepted
				"25":  24,
				"50":  22,
				"100": 20,
			};
			const targetCrf = CRF_TABLE[String(targetSizeMB)] ?? 24;

			// ── Compute a bitrate that fits the target size ──
			// FFmpeg's actual output is always a little larger than the raw
			// bit budget — there's muxing overhead, container metadata,
			// private stream data, etc. Multiplying by EFFICIENCY (~0.85)
			// compensates so the output lands near the chosen target
			// instead of consistently overshooting (same trick compress.lol uses).
			const AUDIO_BPS = 128_000;
			const EFFICIENCY = 0.85;
			const videoBitrateBps = (() => {
				if (probeDuration <= 0) return 1_000_000; // unknown → default 1 Mbps
				const rawBudgetBits = targetSizeMB * 1024 * 1024 * 8;
				const audioTotalBits = (keepAudio ? AUDIO_BPS : 0) * probeDuration;
				const videoBits = rawBudgetBits * EFFICIENCY - audioTotalBits;
				const bps = videoBits / probeDuration;
				// Clamp to [20 kbps, 50 Mbps] so libx264 doesn't choke on
				// absurd values. Extreme cases (8 MB target on a long clip)
				// will still overshoot the target even at the floor;
				// trimming or "Remove Audio" brings it in line.
				return Math.max(20_000, Math.min(bps, 50_000_000));
			})();
			const videoKbps = Math.max(1, Math.round(videoBitrateBps / 1000));

			if (progressText) progressText.innerText =
				`Targeting ${targetSizeMB} MB · ${keepAudio ? `audio + ${videoKbps} kbps video` : `video only · ${videoKbps} kbps`}`;

			// ── Build the encode args ──
			// -crf    : per-preset quality floor.
			// -b:v    : average bitrate cap sized to the chosen target.
			// -maxrate / -bufsize : VBV constraint so x264 can't bloat a
			//                       single scene and starve the rest.
			// -pix_fmt yuv420p : broad playback compatibility (Discord,
			//                    QuickTime preview, older players).
			const args: string[] = [
				'-y',
				'-i', inputPath,
				'-c:v', 'libx264',
				'-preset', 'fast',
				'-crf', String(targetCrf),
				'-b:v', `${videoKbps}k`,
				'-maxrate', `${Math.max(1, Math.round(videoKbps * 1.2))}k`,
				'-bufsize', `${Math.max(2, Math.round(videoKbps * 2))}k`,
				'-pix_fmt', 'yuv420p',
			];
			if (keepAudio) {
				args.push('-c:a', 'aac', '-b:a', '128k');
			} else {
				args.push('-an'); // drop the audio track
			}
			if (keepFps) {
				args.push('-r', probeFps.toFixed(3)); // preserve original FPS
			}
			args.push('-movflags', '+faststart', outputPath); // web-optimized MP4

			await ffmpeg.exec(args);

			if (progressText) progressText.innerText = 'Finalizing output...';
			const data = await ffmpeg.readFile(outputPath) as Uint8Array;
			
			if (usedWorkerFS) {
				await ffmpeg.unmount(inputDir);
				await ffmpeg.deleteDir(inputDir);
			} else {
				await ffmpeg.deleteFile(inputPath);
			}
			await ffmpeg.deleteFile(outputPath);
			
			// 8. Generate Download Link
			const blob = new Blob([data.buffer], { type: "video/mp4" });
			const url = URL.createObjectURL(blob);
			const newSizeMB = (blob.size / (1024 * 1024)).toFixed(2);

			const downloadName = `compressed_${file.name.replace(/\.[^/.]+$/, '')}.mp4`;

			dropZone.innerHTML = `
				<div class="flex flex-col items-center z-10 relative">
					<div class="w-16 h-16 rounded-full bg-emerald-100 border-4 border-emerald-50 flex items-center justify-center mb-6 shadow-sm">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
					</div>
					<h3 class="text-2xl font-bold tracking-tight text-[var(--color-ink)] mb-2">Compression Complete!</h3>
					<p class="text-[15px] font-medium text-[var(--color-mute)] mb-8 bg-[var(--color-canvas-soft-2)] px-4 py-1.5 rounded-full border border-[var(--color-hairline)]">
						Reduced from <span class="font-bold text-[var(--color-ink)]">${sizeMB} MB</span> to <span class="font-bold text-emerald-600">${newSizeMB} MB</span>
					</p>
					
					<a href="${url}" download="${downloadName}" class="flex items-center gap-2 bg-[var(--color-ink)] text-[var(--color-canvas)] px-8 py-3.5 rounded-full font-semibold shadow-lg hover:opacity-90 hover:scale-[1.02]" style="transition: all 200ms ease;">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
						Download Video
					</a>
					<button class="mt-6 text-[15px] font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)]" style="transition: color 150ms ease;" onclick="location.reload()">
						Compress another file
					</button>
				</div>
			`;
		} catch (error: any) {
			console.error('Compression failed:', error);
			const errorMsg = error?.message || String(error);
			dropZone.innerHTML = `
				<div class="flex flex-col items-center z-10 relative">
					<div class="w-16 h-16 rounded-full bg-red-100 border-4 border-red-50 flex items-center justify-center mb-6 shadow-sm">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
					</div>
					<h3 class="text-2xl font-bold tracking-tight text-[var(--color-ink)] mb-3">Compression Failed</h3>
					<p class="text-[14px] text-[var(--color-mute)] mb-6 text-center max-w-[250px]">Something went wrong during processing.</p>
					<button class="bg-[var(--color-ink)] text-[var(--color-canvas)] px-8 py-3.5 rounded-full font-semibold shadow-lg hover:opacity-90" onclick="location.reload()">
						Try Again
					</button>
				</div>
			`;
		} finally {
			isCompressing = false;
		}
	}
</script>
