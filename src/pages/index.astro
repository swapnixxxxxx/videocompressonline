<!-- ═══════════════════════════════════════ SCRIPTS ═══════════════════════════════════════ -->
<script>
	// ── Theme Toggle ──
	const themeBtn = document.getElementById('theme-toggle');
	const iconMoon = document.getElementById('icon-moon');
	const iconSun = document.getElementById('icon-sun');
	const themeLabel = document.getElementById('theme-label');

	function syncThemeUI() {
		const isDark = document.documentElement.classList.contains('dark');
		if (iconMoon && iconSun && themeLabel) {
			iconMoon.style.opacity = isDark ? '0' : '1';
			iconMoon.style.transform = isDark ? 'rotate(-90deg) scale(0)' : 'rotate(0) scale(1)';
			iconSun.style.opacity = isDark ? '1' : '0';
			iconSun.style.transform = isDark ? 'rotate(0) scale(1)' : 'rotate(90deg) scale(0)';
			themeLabel.textContent = isDark ? 'Light' : 'Dark';
		}
	}
	syncThemeUI();

	themeBtn?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.contains('dark');
		document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'light' : 'dark');
		syncThemeUI();
	});


	// ── Slider ↔ Input Sync (Removed) ──

	// ── Segmented Buttons ──
	document.querySelectorAll('.seg-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			const group = btn.getAttribute('data-group');
			document.querySelectorAll(`.seg-btn[data-group="${group}"]`).forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
		});
	});

	// ── Drag & Drop ──
	const dropZone = document.getElementById('drop-zone');
	const dragOverlay = document.getElementById('drag-overlay');
	const fileInput = document.getElementById('file-input') as HTMLInputElement;

	if (dropZone) {
		['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev => {
			dropZone.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); });
			document.body.addEventListener(ev, (e) => { e.preventDefault(); e.stopPropagation(); });
		});

		['dragenter', 'dragover'].forEach(ev => {
			dropZone.addEventListener(ev, () => {
				dropZone.style.borderColor = 'var(--ink)';
				if (dragOverlay) dragOverlay.style.opacity = '1';
			});
		});

		['dragleave', 'drop'].forEach(ev => {
			dropZone.addEventListener(ev, () => {
				dropZone.style.borderColor = '';
				if (dragOverlay) dragOverlay.style.opacity = '0';
			});
		});

		dropZone.addEventListener('drop', (e: DragEvent) => {
			if (e.dataTransfer?.files) handleFiles(e.dataTransfer.files);
		});
	}

	fileInput?.addEventListener('change', function() { if (this.files) handleFiles(this.files); });


	// ── Chunked Upload & Server Streaming Compression Integration ──
	let isProcessing = false;

	function formatBytes(bytes: number, decimals = 2): string {
		if (bytes <= 0) return '0 B';
		const k = 1024;
		const dm = decimals < 0 ? 0 : decimals;
		const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
		const i = Math.floor(Math.log(bytes) / Math.log(k));
		return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
	}

	function formatEta(seconds: number): string {
		if (!isFinite(seconds) || seconds <= 0) return 'Estimating…';
		if (seconds < 60) return `About ${Math.ceil(seconds)}s remaining`;
		const mins = Math.floor(seconds / 60);
		const secs = Math.ceil(seconds % 60);
		return `About ${mins}m ${secs}s remaining`;
	}

	function showError(zone: HTMLElement, title: string, detail: string) {
		zone.style.borderColor = '#ef4444';
		zone.innerHTML = `
			<div class="flex flex-col items-center z-10 relative text-center max-w-md py-4">
				<div class="w-16 h-16 rounded-full bg-red-100 dark:bg-red-950/40 border-4 border-red-50 dark:border-red-900/30 flex items-center justify-center mb-5 shadow-sm">
					<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
				</div>
				<h3 class="text-2xl font-bold tracking-tight text-[var(--color-ink)] mb-2">${title}</h3>
				<p class="text-[14px] text-[var(--color-mute)] mb-6 leading-relaxed px-4">${detail}</p>
				<button class="bg-[var(--color-ink)] text-[var(--color-canvas)] px-8 py-3.5 rounded-full font-semibold shadow-lg hover:opacity-90 cursor-pointer" style="transition: opacity 150ms ease;" onclick="location.reload()">
					Try Again
				</button>
			</div>
		`;
	}

	async function handleFiles(files: FileList) {
		if (files.length === 0) return;
		if (isProcessing) {
			alert('A video is already being processed. Please wait.');
			return;
		}

		const file = files[0];
		const maxAllowed = 2 * 1024 * 1024 * 1024; // 2 GB

		const dropZone = document.getElementById('drop-zone');
		if (!dropZone) return;

		if (file.size > maxAllowed) {
			showError(
				dropZone,
				'File Too Large',
				`Your video is ${formatBytes(file.size)}. The maximum supported video size is 2 GB. Please select a video up to 2 GB.`
			);
			return;
		}

		if (file.size < 1024) {
			showError(
				dropZone,
				'Invalid File',
				'The selected file is too small or empty. Please select a valid video.'
			);
			return;
		}

		// Capture settings BEFORE replacing DOM
		const targetBtn = document.querySelector<HTMLElement>('.seg-btn.active[data-group="target-size"]');
		const audioBtn  = document.querySelector<HTMLElement>('.seg-btn.active[data-group="audio"]');
		const fpsToggle = document.getElementById('fps-toggle') as HTMLInputElement | null;
		const targetSizeMB = parseFloat(targetBtn?.getAttribute('data-value') || '25');
		const keepAudio    = audioBtn?.getAttribute('data-value') !== 'remove';
		const keepFps      = !!fpsToggle?.checked;

		isProcessing = true;

		// Render Uploading Progress Card
		dropZone.style.borderColor = 'var(--primary)';
		dropZone.style.backgroundColor = 'var(--canvas)';
		dropZone.innerHTML = `
			<div class="flex flex-col items-center w-full max-w-md py-2 z-10 relative">
				<div class="w-12 h-12 rounded-full border-[3px] border-[var(--color-hairline-strong)] border-t-[var(--color-primary)] animate-spin mb-4" id="status-spinner"></div>
				<h3 class="text-xl font-bold tracking-tight text-[var(--color-ink)] mb-1" id="process-title">Uploading video…</h3>
				<p class="text-xs font-medium text-[var(--color-mute)] mb-5 max-w-sm truncate text-center" id="process-subtitle">${file.name} · ${formatBytes(file.size)}</p>

				<div class="w-full h-2.5 bg-[var(--color-canvas-soft-2)] rounded-full overflow-hidden shadow-inner border border-[var(--color-hairline)] relative mb-3">
					<div class="absolute top-0 left-0 h-full bg-gradient-to-r from-[#007cf0] via-[#00b4d8] to-[#00dfd8] rounded-full" id="main-progress-bar" style="width: 0%; transition: width 0.2s ease;"></div>
				</div>

				<div class="w-full flex items-center justify-between text-xs font-mono text-[var(--color-ink)] mb-4">
					<span id="progress-pct" class="font-bold text-sm">0%</span>
					<span id="progress-bytes" class="text-[var(--color-mute)]">0 B / ${formatBytes(file.size)}</span>
				</div>

				<div class="w-full grid grid-cols-2 gap-3 text-xs bg-[var(--color-canvas-soft-2)] border border-[var(--color-hairline)] rounded-xl p-3 mb-3" id="speed-eta-panel">
					<div class="flex flex-col text-left">
						<span class="text-[10px] text-[var(--color-mute)] uppercase tracking-wider font-semibold">Speed</span>
						<span class="font-mono font-medium text-[var(--color-ink)]" id="upload-speed">0.0 MB/s</span>
					</div>
					<div class="flex flex-col text-right">
						<span class="text-[10px] text-[var(--color-mute)] uppercase tracking-wider font-semibold">Time Remaining</span>
						<span class="font-mono font-medium text-[var(--color-ink)]" id="upload-eta">Estimating…</span>
					</div>
				</div>

				<p class="text-[11px] text-[var(--color-mute)] text-center" id="status-detail">
					Chunked streaming upload active &middot; Browser memory safe
				</p>
			</div>
		`;

		const titleEl = document.getElementById('process-title');
		const subtitleEl = document.getElementById('process-subtitle');
		const progressBar = document.getElementById('main-progress-bar') as HTMLElement | null;
		const pctEl = document.getElementById('progress-pct');
		const bytesEl = document.getElementById('progress-bytes');
		const speedEl = document.getElementById('upload-speed');
		const etaEl = document.getElementById('upload-eta');
		const detailEl = document.getElementById('status-detail');
		const speedPanel = document.getElementById('speed-eta-panel');

		try {
			// ── Step 1: Pre-flight init ──
			if (detailEl) detailEl.textContent = 'Initializing secure upload session…';
			const initRes = await fetch('/api/upload/init', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					fileName: file.name,
					fileSize: file.size,
					fileType: file.type || 'video/mp4',
					settings: { targetSizeMB, keepAudio, keepFps },
				}),
			});

			if (!initRes.ok) {
				const errData = await initRes.json().catch(() => ({}));
				throw new Error(errData.error || `Upload initialization failed (${initRes.status})`);
			}

			const { uploadId, chunkSize, totalChunks } = await initRes.json();

			// ── Step 2: Resumable chunked upload with controlled concurrency (2) ──
			const CONCURRENCY = 2;
			const chunkBytesUploaded = new Array(totalChunks).fill(0);
			let totalUploadedBytes = 0;
			const startTime = performance.now();
			let lastSpeedCalcTime = startTime;
			let lastSpeedCalcBytes = 0;
			let currentSpeedBps = 0;

			function updateUploadUI(pct: number, uploadedBytes: number, speedBps: number) {
				if (progressBar) progressBar.style.width = `${pct}%`;
				if (pctEl) pctEl.textContent = `${pct}%`;
				if (bytesEl) bytesEl.textContent = `${formatBytes(uploadedBytes)} / ${formatBytes(file.size)}`;
				if (speedEl) speedEl.textContent = `${(speedBps / (1024 * 1024)).toFixed(1)} MB/s`;

				if (etaEl) {
					if (speedBps > 50_000) {
						const remainingBytes = Math.max(0, file.size - uploadedBytes);
						const remainingSec = remainingBytes / speedBps;
						etaEl.textContent = formatEta(remainingSec);
					} else {
						etaEl.textContent = 'Estimating…';
					}
				}
			}

			async function uploadSingleChunk(index: number, maxRetries = 4): Promise<void> {
				const start = index * chunkSize;
				const end = Math.min(start + chunkSize, file.size);
				// File.slice() keeps ONLY the current 10 MB slice in memory!
				const chunkBlob = file.slice(start, end);
				const expectedSize = end - start;

				let attempt = 0;
				while (attempt < maxRetries) {
					try {
						const res = await fetch('/api/upload/chunk', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/octet-stream',
								'X-Upload-Id': uploadId,
								'X-Chunk-Index': String(index),
							},
							body: chunkBlob,
						});

						if (!res.ok) {
							const errJson = await res.json().catch(() => ({}));
							throw new Error(errJson.error || `HTTP ${res.status}`);
						}

						chunkBytesUploaded[index] = expectedSize;
						return;
					} catch (err: any) {
						attempt++;
						if (attempt >= maxRetries) {
							throw new Error(`Upload error on chunk ${index + 1}/${totalChunks}: ${err?.message || 'Network failure'}`);
						}
						const backoff = Math.min(1000 * Math.pow(2, attempt - 1), 4000);
						if (detailEl) detailEl.textContent = `Network glitch on chunk ${index + 1}. Retrying in ${backoff / 1000}s…`;
						await new Promise((r) => setTimeout(r, backoff));
					}
				}
			}

			// UI ticker running every 200ms
			const progressTicker = setInterval(() => {
				totalUploadedBytes = chunkBytesUploaded.reduce((a, b) => a + b, 0);
				const now = performance.now();
				const elapsedWindowSec = (now - lastSpeedCalcTime) / 1000;
				if (elapsedWindowSec >= 0.4) {
					const bytesInWindow = totalUploadedBytes - lastSpeedCalcBytes;
					currentSpeedBps = bytesInWindow / elapsedWindowSec;
					lastSpeedCalcTime = now;
					lastSpeedCalcBytes = totalUploadedBytes;
				}

				const pct = Math.min(99, Math.round((totalUploadedBytes / file.size) * 100));
				updateUploadUI(pct, totalUploadedBytes, currentSpeedBps);
			}, 200);

			// Run upload queue with controlled concurrency
			let nextChunkIdx = 0;
			async function worker(): Promise<void> {
				while (nextChunkIdx < totalChunks) {
					const idx = nextChunkIdx++;
					await uploadSingleChunk(idx);
				}
			}

			const workers = Array.from({ length: Math.min(CONCURRENCY, totalChunks) }, () => worker());
			await Promise.all(workers);
			clearInterval(progressTicker);

			updateUploadUI(100, file.size, currentSpeedBps);

			// ── Step 3: Complete upload and initiate server compression ──
			if (titleEl) titleEl.textContent = 'Upload complete!';
			if (detailEl) detailEl.textContent = 'Reassembling video streams & preparing compression engine…';

			const completeRes = await fetch('/api/upload/complete', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					uploadId,
					settings: { targetSizeMB, keepAudio, keepFps },
				}),
			});

			if (!completeRes.ok) {
				const errData = await completeRes.json().catch(() => ({}));
				throw new Error(errData.error || 'Failed to assemble video on server.');
			}

			const { jobId } = await completeRes.json();

			// ── Step 4: Poll compression job status ──
			if (titleEl) titleEl.textContent = 'Compressing video…';
			if (subtitleEl) subtitleEl.textContent = `Target: ${targetSizeMB} MB · ${keepAudio ? 'Audio preserved' : 'No audio'}`;
			if (progressBar) progressBar.style.width = '2%';
			if (pctEl) pctEl.textContent = '0%';
			if (bytesEl) bytesEl.textContent = 'Server processing';
			if (speedPanel) speedPanel.style.display = 'none';
			if (detailEl) detailEl.textContent = 'Encoding video frames with native H.264…';

			while (true) {
				await new Promise((r) => setTimeout(r, 1000));

				const jobRes = await fetch(`/api/jobs/${jobId}`);
				if (!jobRes.ok) continue;

				const job = await jobRes.json();

				if (job.status === 'completed') {
					// ── Step 5: Render Complete Download UI ──
					const originalSizeStr = formatBytes(job.originalSize);
					const compressedSizeStr = formatBytes(job.compressedSize);
					const savingsPct = Math.max(1, Math.round((1 - job.compressedSize / job.originalSize) * 100));

					dropZone.innerHTML = `
						<div class="flex flex-col items-center z-10 relative py-2">
							<div class="w-16 h-16 rounded-full bg-emerald-100 dark:bg-emerald-950/40 border-4 border-emerald-50 dark:border-emerald-900/30 flex items-center justify-center mb-5 shadow-sm">
								<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
							</div>
							<h3 class="text-2xl font-bold tracking-tight text-[var(--color-ink)] mb-2">Compression Complete!</h3>
							<div class="flex flex-wrap items-center justify-center gap-2 mb-8">
								<span class="text-xs font-medium text-[var(--color-mute)] bg-[var(--color-canvas-soft-2)] px-3.5 py-1.5 rounded-full border border-[var(--color-hairline)]">
									${originalSizeStr} &rarr; <strong class="text-emerald-600 dark:text-emerald-400 font-bold">${compressedSizeStr}</strong>
								</span>
								<span class="text-xs font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 px-3 py-1.5 rounded-full">
									${savingsPct}% smaller
								</span>
							</div>

							<a href="${job.downloadUrl}" class="flex items-center gap-2.5 bg-[var(--color-ink)] text-[var(--color-canvas)] px-8 py-3.5 rounded-full font-semibold shadow-lg hover:opacity-90 hover:scale-[1.02] cursor-pointer" style="transition: all 200ms ease;">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
								Download Video
							</a>
							<button class="mt-6 text-sm font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] cursor-pointer" style="transition: color 150ms ease;" onclick="location.reload()">
								Compress another file
							</button>
						</div>
					`;
					isProcessing = false;
					return;
				}

				if (job.status === 'failed') {
					throw new Error(job.error || 'Compression failed. The video format may be unsupported.');
				}

				// Update compression progress
				const compPct = Math.min(99, Math.max(2, job.progress || 2));
				if (progressBar) progressBar.style.width = `${compPct}%`;
				if (pctEl) pctEl.textContent = `${compPct}%`;
				if (detailEl && job.statusText) detailEl.textContent = job.statusText;
			}
		} catch (err: any) {
			console.error('Processing error:', err);
			showError(dropZone, 'Processing Failed', err?.message || 'An unexpected error occurred. Please try again.');
			isProcessing = false;
		}
	}
</script>

