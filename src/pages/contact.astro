---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="Contact Us - VideoCompressOnline" 
	description="Get in touch with the VideoCompressOnline team for support, feedback, or inquiries."
>
	<header class="w-full bg-[var(--color-canvas)]/80 backdrop-blur-xl border-b border-[var(--color-hairline)] h-16 flex items-center sticky top-0 z-50">
		<div class="max-w-6xl mx-auto w-full px-6 flex items-center justify-between">
			<a href="/" class="flex items-center gap-2.5 group">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="text-[var(--color-ink)]">
					<path d="M12 2L2 7l10 5 10-5-10-5z" fill="currentColor" opacity="0.15"/>
					<path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
				<span class="font-bold text-[15px] tracking-[-0.3px] text-[var(--color-ink)]">VideoCompressOnline</span>
			</a>
			<a href="/" class="text-sm font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)]">Back to Home</a>
		</div>
	</header>

	<main class="flex-grow max-w-4xl mx-auto px-6 py-16 md:py-24 text-[var(--color-body)] leading-relaxed">
		<h1 class="text-3xl md:text-4xl font-bold tracking-[-0.03em] text-[var(--color-ink)] mb-8">Contact Us</h1>
		
		<div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-start">
			<div class="space-y-6 text-[15px]">
				<p>Have a question, feedback, or need support? We'd love to hear from you.</p>
				
				<h2 class="text-xl font-bold text-[var(--color-ink)] mt-8">Email Support</h2>
				<p>For general inquiries or technical support, please email us at:<br>
				<a href="mailto:jarvis878@protonmail.com" class="text-[var(--color-ink)] font-semibold underline">jarvis878@protonmail.com</a></p>
				
				<h2 class="text-xl font-bold text-[var(--color-ink)] mt-8">Feedback</h2>
				<p>We are constantly improving VideoCompressOnline. If you have feature requests or found a bug, letting us know via email is the best way to help us improve.</p>
			</div>
			
			<div class="bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] p-8 md:p-10 rounded-xl w-full">
				<h3 class="text-xl font-bold text-[var(--color-ink)] mb-6">Send a Message</h3>
				<form class="space-y-5" onsubmit="event.preventDefault(); alert('Message sent successfully! We will get back to you soon.'); this.reset();">
					<div>
						<label for="name" class="block text-xs font-semibold text-[var(--color-mute)] uppercase tracking-wider mb-2">Name</label>
						<input type="text" id="name" required class="w-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)] text-sm rounded-md px-4 py-3 outline-none focus:border-[var(--color-ink)] transition-colors">
					</div>
					<div>
						<label for="email" class="block text-xs font-semibold text-[var(--color-mute)] uppercase tracking-wider mb-2">Email</label>
						<input type="email" id="email" required class="w-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)] text-sm rounded-md px-4 py-3 outline-none focus:border-[var(--color-ink)] transition-colors">
					</div>
					<div>
						<label for="message" class="block text-xs font-semibold text-[var(--color-mute)] uppercase tracking-wider mb-2">Message</label>
						<textarea id="message" rows="5" required class="w-full bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)] text-sm rounded-md px-4 py-3 outline-none focus:border-[var(--color-ink)] transition-colors resize-none"></textarea>
					</div>
					<button type="submit" class="w-full bg-[var(--color-ink)] text-[var(--color-canvas)] px-6 py-3.5 rounded-md font-semibold text-sm hover:opacity-90 transition-opacity mt-2">
						Send Message
					</button>
				</form>
			</div>
		</div>
	</main>

	<footer class="w-full border-t border-[var(--color-hairline)] bg-[var(--color-canvas)] py-8 px-6 mt-auto">
		<div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center text-xs text-[var(--color-mute)] gap-3">
			<p>&copy; 2026 VideoCompressOnline — Free Online Video Compressor. Built for speed and privacy.</p>
			<div class="flex gap-5">
				<a href="/terms" class="hover:text-[var(--color-ink)]" style="transition: color 150ms ease;">Terms</a>
				<a href="/privacy" class="hover:text-[var(--color-ink)]" style="transition: color 150ms ease;">Privacy</a>
				<a href="/contact" class="hover:text-[var(--color-ink)]" style="transition: color 150ms ease;">Contact</a>
				<a href="/about" class="hover:text-[var(--color-ink)]" style="transition: color 150ms ease;">About</a>
				<a href="/#faq" class="hover:text-[var(--color-ink)]" style="transition: color 150ms ease;">FAQ</a>
			</div>
		</div>
	</footer>
</Layout>
