---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Contact Us - VideoCompressOnline" 
	description="Get in touch with the VideoCompressOnline team for support, feedback, or inquiries."
>
	<Header tone="light" />

	<section class="band-light w-full border-b border-[var(--color-hairline)]">
		<div class="max-w-[1152px] mx-auto px-4 md:px-6 pt-16 pb-10 md:pt-24 md:pb-12">
			<p class="eyebrow mb-3">Support</p>
			<h1 class="display-large text-[var(--color-ink)]">Contact Us</h1>
		</div>
	</section>

	<main class="band-light flex-grow w-full">
	<div class="doc max-w-[1152px] mx-auto px-4 md:px-6 py-12 md:py-16">
		
		<div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-start">
			<div>
				<p class="body-lg">Have a question, feedback, or need support? We'd love to hear from you.</p>
				
				<h2>Email support</h2>
				<p>For general inquiries or technical support, please email us at:<br>
				<a href="mailto:jarvis878@protonmail.com" class="font-semibold">jarvis878@protonmail.com</a></p>
				
				<h2>Feedback</h2>
				<p>We are constantly improving VideoCompressOnline. If you have feature requests or found a bug, letting us know via email is the best way to help us improve.</p>
			</div>
			
			<div class="card w-full p-6 md:p-8" style="box-shadow: rgba(0,0,0,0.1) 0 10px 15px -3px, rgba(0,0,0,0.1) 0 4px 6px -4px;">
				<h2 class="!mt-0 !mb-6">Send a message</h2>
				<form class="space-y-5" onsubmit="event.preventDefault(); alert('Message sent successfully! We will get back to you soon.'); this.reset();">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label for="first-name" class="field-label">First name</label>
							<input type="text" id="first-name" autocomplete="given-name" required class="field" />
						</div>
						<div>
							<label for="last-name" class="field-label">Last name</label>
							<input type="text" id="last-name" autocomplete="family-name" class="field" />
						</div>
					</div>
					<div>
						<label for="email" class="field-label">Email</label>
						<input type="email" id="email" autocomplete="email" required class="field" />
					</div>
					<div>
						<label for="message" class="field-label">Message</label>
						<textarea id="message" rows="5" required class="field resize-none"></textarea>
					</div>
					<button type="submit" class="btn btn-primary w-full">Send message</button>
				</form>
			</div>
		</div>
	</div>
	</main>

	<Footer />
</Layout>
