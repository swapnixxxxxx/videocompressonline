---
interface Props {
	title?: string;
	description?: string;
	canonicalURL?: string;
	schemas?: Record<string, any>[];
}

const {
	title = "Video Compressor Online — Reduce Video File Size Free",
	description = "Use our fast video compressor online to compress video files and reduce video size without noticeable quality loss. Easily compress MP4 videos for free.",
	canonicalURL,
	schemas,
} = Astro.props;

const effectiveCanonical = canonicalURL || new URL(Astro.url.pathname, "https://www.videocompressonline.com").href;
const siteName = "VideoCompressOnline";
const ogImageURL = "https://www.videocompressonline.com/og-image.jpg";

const defaultSchemas: Record<string, any>[] = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": "VideoCompressOnline",
		"url": "https://www.videocompressonline.com/",
		"description": "Fast video compressor online to compress video files and reduce video size.",
	},
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		"name": "VideoCompressOnline",
		"url": "https://www.videocompressonline.com/",
		"description": "Online video compressor to reduce video size and compress MP4, WebM, MKV, and MOV files up to 2 GB.",
		"applicationCategory": "MultimediaApplication",
		"operatingSystem": "All",
		"offers": {
			"@type": "Offer",
			"price": "0",
			"priceCurrency": "USD",
		},
		"featureList": [
			"Compress MP4, WebM, MKV, MOV videos online",
			"Reduce video size up to 90%",
			"Discord-compatible 8MB and email 25MB presets",
			"Large file support up to 2 GB with chunked streaming",
			"Preserve original framerates or remove audio tracks",
			"No registration or watermarks",
		],
	},
];

const renderedSchemas = schemas && schemas.length > 0 ? schemas : defaultSchemas;
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#1f1633" />

		<!-- Fonts: Rubik (UI) + Space Grotesk (display substitute) — see DESIGN.md -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P2SJQ42GWC"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-P2SJQ42GWC');
		</script>

		<!-- ═══════════ PRIMARY SEO META ═══════════ -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={effectiveCanonical} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="author" content="VideoCompressOnline" />

		<!-- ═══════════ OPEN GRAPH / FACEBOOK ═══════════ -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={effectiveCanonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />

		<!-- ═══════════ TWITTER CARD ═══════════ -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={title} />

		<!-- ═══════════ STRUCTURED DATA (JSON-LD) ═══════════ -->
		{renderedSchemas.map((s) => (
			<script type="application/ld+json" set:html={JSON.stringify(s)} />
		))}


		<script is:inline>
			// ─── Pre-hydration: apply saved theme + language before paint ───
			// Runs synchronously in <head> so visitors never see a flash of
			// light/dark or a language flicker. All errors fall through to
			// the SSR defaults; nothing here throws past the catch.
			(function () {
				var h = document.documentElement;
				var THEMES = ['light', 'dark'];
				var LANGS = { en: 'ltr', es: 'ltr', fr: 'ltr', de: 'ltr', pt: 'ltr', ar: 'rtl' };
				try {
					// Theme
					var t = null;
					try { t = localStorage.getItem('theme'); } catch (e) {}
					// Legacy dark themes (ocean/solar) map to dark; sepia maps to light.
					if (t === 'ocean' || t === 'solar') t = 'dark';
					if (!t || THEMES.indexOf(t) === -1) t = 'light';
					h.setAttribute('data-theme', t);
					if (t === 'dark') h.classList.add('dark');

					// Language
					var saved = null;
					try { saved = localStorage.getItem('lang'); } catch (e) {}
					var navLang = (navigator.language || 'en').slice(0, 2).toLowerCase();
					var l = LANGS[saved] ? saved : (LANGS[navLang] ? navLang : 'en');
					h.setAttribute('lang', l);
					h.setAttribute('dir', LANGS[l]);
				} catch (e) {
					/* SSR defaults already render */
				}
			})();
		</script>

		<!-- Post-hydration: wires the theme cycle + language dropdown. -->
		<script>
			import '../scripts/personalize.ts';
		</script>
	</head>
	<body class="antialiased min-h-screen flex flex-col overflow-x-hidden w-full max-w-[100vw]">
		<slot />
	</body>
</html>

<style>
	@import "../styles/global.css";
</style>
